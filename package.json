{
	"name": "obsidian-plugin-journal-review",
	"version": "4.0.0",
	"description": "Review your daily notes on their anniversaries, like \"what happened today last year\"\n\n",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test --require ts-node/register/transpile-only tests/*.test.ts",
		"version": "node version-bump.mjs && npm run format && git add manifest.json versions.json",
		"lint": "eslint . && knip && prettier --check .",
		"format": "prettier --write .",
		"generateNotes": "ts-node ./scripts/generateNotes.ts vault 5",
		"knip": "knip"
	},
	"keywords": [],
	"author": "Kageetai",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"@typescript-eslint/parser": "^8.71.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"knip": "^6.41.0",
		"moment": "^2.31.0",
		"obsidian": "latest",
		"prettier": "^3.9.10",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "^0.9.5",
		"preact": "^11.0.1"
	},
	"overrides": {
		"moment": "$moment",
		"typescript": "$typescript",
		"obsidian-daily-notes-interface": {
			"obsidian": "$obsidian"
		}
	}
}
